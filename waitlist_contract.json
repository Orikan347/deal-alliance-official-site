{
  "version": "DA-WAITLIST-0.1",
  "status": "CONTRACT_READY_ENDPOINT_PENDING",
  "purpose": "候補／洽詢最小收件與 readback 契約，不代表已啟用正式收件。",
  "request": {
    "method": "POST",
    "content_type": "application/json",
    "fields": {
      "topic": "approved enum string",
      "contact": "user-provided contact string; receiver validates and minimizes",
      "consent": "true",
      "source": "official-site-waitlist",
      "client_request_id": "opaque UUID for deduplication/readback correlation"
    },
    "forbidden": ["password", "payment", "license_key", "student_id", "customer_list", "message_content"]
  },
  "response": {
    "success_status": 202,
    "content_type": "application/json",
    "required": {"ok": true, "request_id": "opaque receiver-generated ID", "status": "received"},
    "must_not_return": ["raw_database_row", "secret", "full_contact_record"]
  },
  "receiver_gates": [
    "HTTPS only in production",
    "Origin allowlist",
    "rate limit and abuse protection",
    "server-side schema validation",
    "deduplication by client_request_id",
    "privacy-version and retention policy readback",
    "masked operational logs only",
    "operator-only readback; no public list endpoint"
  ],
  "privacy": {"data_minimization": true, "retention_days": null, "deletion_request_path": "PENDING_PRIVACY_REVIEW"}
}
